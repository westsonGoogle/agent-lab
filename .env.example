# 任何 OpenAI 兼容的 /chat/completions 端点都能用,比如:
#   OpenAI      https://api.openai.com/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Moonshot    https://api.moonshot.cn/v1
#   本地 Ollama http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini

# 可选:温度 / 单次最大输出 token / 循环上限
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
AGENT_MAX_STEPS=8

# 可选:文件工具沙箱根目录,默认当前目录
ALLOWED_ROOT=.

# 可选:推理型模型的思考强度(none/low/medium/high),留空则不发送
# LLM_REASONING_EFFORT=none

# 可选:额外请求头(JSON)。某些网关要求特定 header,例如 opencode:
# LLM_EXTRA_HEADERS={"x-opencode-session":"agent-lab-local"}
